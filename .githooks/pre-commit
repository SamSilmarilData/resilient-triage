#!/usr/bin/env bash
# Lint and format check before every commit. Tests stay out of the hook so a
# test-first "red" commit can land; CI and scripts/check.sh run them.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bin=""
[[ -x .venv/bin/python ]] && bin=".venv/bin/"

"${bin}ruff" check .
"${bin}ruff" format --check .
