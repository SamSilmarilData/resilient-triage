# Application Configuration
APP_NAME=resilient-triage
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Redis & Semantic Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=3600

# Telemetry Configuration
STATUSPAGE_URL=https://www.githubstatus.com/api/v2/summary.json

# Resilience & Circuit Breaker
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_TIMEOUT=30
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=0.1
RETRY_MAX_WAIT_SECONDS=1.0
TELEMETRY_SOURCE_DEADLINE_S=5.0

# Self-Repair Loop
MAX_SELF_REPAIR_RETRIES=2

# Triage Gateway (run slots and load shedding)
TRIAGE_MAX_CONCURRENT_RUNS=10
TRIAGE_QUEUE_TIMEOUT_S=5.0
TRIAGE_RUN_DEADLINE_S=45.0

# LLM Provider (Groq; leave GROQ_API_KEY unset to run the zero-config simulation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
LLM_REQUEST_TIMEOUT_S=20.0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2500
LLM_MAX_KEEPALIVE_CONNECTIONS=20
LLM_MAX_CONNECTIONS=50
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_DEFAULT_COOLDOWN_S=30.0
LLM_MAX_COOLDOWN_S=3600.0

# Admin routes (/chaos/inject, /resilience/reset, /cache/clear) need X-Admin-Key equal to this.
# Unset or empty: they fail closed with 403. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-local-admin-key
